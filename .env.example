# ============================================
# CircularOS Environment Configuration (LOCAL DEV)
# Git-ignored. Do not commit.
# ============================================

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://circularos:circularos_dev@localhost:5433/circularos
DATABASE_SYNC_URL=postgresql://circularos:circularos_dev@localhost:5433/circularos
POSTGRES_USER=circularos
POSTGRES_PASSWORD=circularos_dev
POSTGRES_DB=circularos

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# ── Authentication ───────────────────────────
JWT_SECRET=-7EAVGFjLWFe4qDxmJV9SwE2yWVmPUdjcv_D1es_B4AIfOtXANZr-dpVLhjY4qIB
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=M0i0PiuL1SGlOtuk3Ojz-n89B0ofDOG7ApR_Iy7zEdw

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── LLM Providers ───────────────────────────

# OpenAI / Anthropic: leave empty unless you have paid keys.
# The routing below doesn't point to them, so they won't be called.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Gemini: primary key + rotation keys from DIFFERENT GCP projects.
# Each project gets its own 250 RPD on 2.5 Flash. 4 keys = 1000 RPD.
# Get keys at https://aistudio.google.com → "Get API key" → create in a new project.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-2.5-flash

# Groq: free, no credit card, 30 RPM / 1K RPD per model.
# Get key at https://console.groq.com
GROQ_API_KEY=

# ── Model Routing ────────────────────────────
# fast  → Groq  (high RPD, blazing speed, handles volume)
# reasoning → Gemini 2.5 Flash (best structured output quality on free tier)
# critic → Groq  (DIFFERENT model family from reasoning = genuine second opinion)

FAST_MODEL_PROVIDER=groq
FAST_MODEL_NAME=openai/gpt-oss-120b

REASONING_MODEL_PROVIDER=gemini
REASONING_MODEL_NAME=gemini-2.5-flash

CRITIC_MODEL_PROVIDER=groq
CRITIC_MODEL_NAME=openai/gpt-oss-120b

# If Groq deprecates gpt-oss-120b, check console.groq.com/docs/models and try:
#   FAST_MODEL_NAME=llama-3.3-70b-versatile
#   CRITIC_MODEL_NAME=qwen/qwen3.6-27b    (different family from fast = even better)

# ── Embedding ────────────────────────────────
# Used by the diff engine Level 3 (semantic clause matching).
# Gemini text-embedding-004 is free-tier.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# ── Reranker ─────────────────────────────────
RERANKER_PROVIDER=
RERANKER_MODEL=

# ── Observability ────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=circularos

LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Knowledge Graph ──────────────────────────
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# ── External Sources ────────────────────────
SEBI_SOURCE_BASE_URL=https://www.sebi.gov.in

# ── Application ──────────────────────────────
APP_NAME=CircularOS
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
WORKER_CONCURRENCY=4

# ── File Storage ─────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10